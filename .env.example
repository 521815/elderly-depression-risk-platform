# 把真实 Key 放到 .env，不要提交到仓库
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini
# 如果使用兼容 OpenAI 协议的其他服务，例如 DeepSeek/Qwen，填写其接口地址
OPENAI_BASE_URL=

# 首次创建账号库时写入的初始账号；已有账号不会被覆盖
DEFAULT_ADMIN_USERNAME=mintz
DEFAULT_ADMIN_PASSWORD=<set-a-strong-unique-password>
DEFAULT_USER_USERNAME=careuser01
DEFAULT_USER_PASSWORD=<set-a-strong-unique-password>

# CMDC 数据目录与归档密码；密码只放在本机 .env 或当前终端环境中
CMDC_ROOT=<path-to-cmdc-archives>
CMDC_ARCHIVE_PASSWORD=
